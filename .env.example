# Barcha o‘zgaruvchilar IXTIYORIY. Bo‘sh qolsa, src/lib/submit.ts dagi amaldagi qiymatlar ishlatiladi
# (sayt, /avtosalon va /qurilish formalari uchun bitta Apps Script endpoint).

# Apps Script web app URL (docs/apps-script.gs). Faqat boshqa deployment'ga o‘tkazish uchun.
VITE_APPLICATION_ENDPOINT=
# Apps Script dagi TOKEN bilan bir xil bo‘lsin. Bu brauzerda ochiq identifikator, maxfiy kalit emas.
VITE_APPLICATION_TOKEN=

# Meta Pixel ID (/avtosalon va /qurilish). Bo‘sh bo‘lsa pixel yuklanmaydi.
VITE_META_PIXEL_ID=

{
  "name": "fazo-digital",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "build:preview": "vite build --mode singlefile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:spa": "vite build",
    "test": "node --import ./tests/helpers/ts-hooks.mjs --test tests/*.test.mjs",
    "verify": "npm run build && npm test && node scripts/uz-sh.mjs --check $(cat scripts/uz-files.txt)"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/manrope": "^5.1.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.4",
    "framer-motion": "^13.4.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.26",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
